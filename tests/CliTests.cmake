function(expect_exit expected)
    execute_process(COMMAND "${UTILITY}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${result}: ${errors}")
    endif()
endfunction()
expect_exit(2 invalid-command)
expect_exit(2 dumpsys --section not-a-section --url invalid-url)
expect_exit(2 dumpsys --format invalid)
expect_exit(2 dumpsys --timeout-ms 0)
expect_exit(2 dumpsys --timeout-ms 10suffix)
expect_exit(2 plugins --section runtime)
expect_exit(2 dumpsys --unknown value)
expect_exit(2 dumpsys --profile "${CMAKE_CURRENT_LIST_DIR}/missing-profile.json")
expect_exit(0 list --format json)
expect_exit(1 dumpsys --section platform --url https://192.0.2.1:9998 --format json)